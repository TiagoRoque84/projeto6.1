# ==============================================
# CONFIGURAÇÃO BÁSICA
# ==============================================
SECRET_KEY=troque-esta-chave-em-producao
SQLALCHEMY_DATABASE_URI=sqlite:///saas_app.db

# ==============================================
# MULTI-TENANCY
# ==============================================
# True = Desenvolvimento local, False = Produção
DEVELOPMENT_MODE=True

# True = Usa subdomínios, False = Usa parâmetro ?tenant=X
USE_SUBDOMAINS=True

# Domínio base (local para dev, seu domínio real para produção)
BASE_DOMAIN=local

# Subdomínio do super admin
SUPER_ADMIN_SUBDOMAIN=admin

# ==============================================
# SUPER ADMIN (Credenciais iniciais)
# ==============================================
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=admin123
SUPER_ADMIN_EMAIL=admin@seudominio.com

# ==============================================
# TRIAL
# ==============================================
TRIAL_DAYS=14

# ==============================================
# EMAIL (Para envio de credenciais aos clientes)
# ==============================================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@seudominio.com

# ==============================================
# UPLOAD
# ==============================================
UPLOAD_FOLDER=uploads
